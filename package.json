        "seed:accounts": "tsx scripts/seed-accounts.ts",
        "check:integrations": "node scripts/check-integrations.mjs",
        "derive:b2": "node scripts/derive-b2.mjs",
        "migrate:secrets": "node scripts/migrate-secrets.mjs",
        "create-admin": "tsx scripts/create-admin.ts",
        "parity-check": "node scripts/parity-check.mjs",
        "php-stylesheet-order": "node scripts/php-stylesheet-order.mjs",
        "css-usage": "node scripts/css-usage.mjs",
        "css-conflicts": "node scripts/css-conflicts.mjs",
        "php-chrome-map": "node scripts/php-chrome-map.mjs",
