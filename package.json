        "@types/react-dom": "19.3.0",
        "@types/sanitize-html": "2.16.2",
        "eslint": "9.39.5",
        "eslint-config-next": "16.4.0",
        "pixelmatch": "^8.0.0",
        "playwright": "^1.64.0",
        "pngjs": "^7.0.0",
        "tsx": "4.23.15",
        "typescript": "5.9.3",
        "vitest": "5.0.3"
