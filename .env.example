# Edulari environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# Placeholder values only — do not put real secrets here or in docs.

# --- Site ---
# Canonical public origin; used for canonical URLs, emails, OAuth redirects, sitemap.
NEXT_PUBLIC_SITE_URL=https://edulari.example.com
# Display name of the site (mirrors SITE_NAME).
SITE_NAME=Edulari
# Admin/support contact email surfaced as support email.
ADMIN_EMAIL=admin@example.com
# Display currency code for prices (PHP default 'INR').
CURRENCY_CODE=INR
# Symbol shown next to prices (PHP default '₹').
CURRENCY_SYMBOL=₹
# IANA timezone every "today"/date computation runs in.
# private/config.php hard-codes date_default_timezone_set('Asia/Kolkata'); Vercel is UTC.
APP_TIMEZONE=Asia/Kolkata

# --- Database (Supabase Postgres) ---
# Connection rule (IPv4-only): use the Session Pooler for BOTH; set identical values.
# DATABASE_URL and DIRECT_URL use the same Session Pooler string (aws-0-ap-south-1.pooler.supabase.com, port 5432, user postgres.<project-ref>).
# postgres.js must be created with { prepare: false } (transaction-mode pooler).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Same Session Pooler string as DATABASE_URL; used by migrations/scripts only.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- Encryption at rest ---
# AES-256-GCM key (32 bytes, base64) for encrypting instructor PAN/bank/UPI data.
DATA_ENCRYPTION_KEY=base64-64-characters-required

# --- Sessions / CSRF ---
# Cryptographically random secrets (generate with `openssl rand -base64 32`).
SESSION_SECRET=
CSRF_SECRET=
# Name of the session cookie.
SESSION_COOKIE_NAME=edulari_session
# Session lifetime in seconds (default 86400, mirrors PHP SESSION_LIFETIME).
SESSION_LIFETIME=86400

# --- SMTP Email (Nodemailer) ---
# SMTP server hostname.
SMTP_HOST=smtp.example.com
# SMTP server port.
SMTP_PORT=587
# Whether the connection uses TLS/SSL (serialise as 'tls'|'ssl'|'' like PHP SMTP_SECURE).
SMTP_SECURE=false
# Whether SMTP auth is required (mirrors PHP SMTP_AUTH).
SMTP_AUTH=true
# SMTP login username.
SMTP_USERNAME=noreply@example.com
# SMTP login password / app password.
SMTP_PASSWORD=
# When true, emails are logged instead of sent (used by scripts/smoke-phase7.ts).
EMAIL_DRY_RUN=false
# From: address on outgoing mail.
SMTP_FROM_EMAIL=noreply@example.com
# From: display name.
SMTP_FROM_NAME=Edulari

# --- Backblaze B2 (S3-compatible) ---
# S3-compatible endpoint URL for the bucket's region.
B2_ENDPOINT=https://s3.us-west-002.backblazeb2.com
# B2 region string.
B2_REGION=us-west-002
# B2 bucket name (mirrors B2_BUCKET_NAME).
B2_BUCKET_NAME=edulari
# B2 bucket id.
B2_BUCKET_ID=
# B2 application key id.
B2_KEY_ID=
# B2 application key.
B2_APPLICATION_KEY=

# --- Razorpay ---
# Public key id used by checkout.
RAZORPAY_KEY_ID=
# Secret for order/payment signature verification.
RAZORPAY_KEY_SECRET=
# Separate webhook payload signature secret.
RAZORPAY_WEBHOOK_SECRET=
# Live-mode flag; test keys must never be used with live traffic.
RAZORPAY_LIVE=false

# --- Google OAuth ---
# Google OAuth web client id.
GOOGLE_CLIENT_ID=
# Google OAuth web client secret.
GOOGLE_CLIENT_SECRET=

# --- GitHub OAuth ---
# GitHub OAuth app client id.
GITHUB_CLIENT_ID=
# GitHub OAuth app client secret.
GITHUB_CLIENT_SECRET=

# --- AI providers ---
# Active provider: openrouter | nvidia_kimi (student chat uses Groq directly).
ACTIVE_AI_PROVIDER=openrouter
# OpenRouter chat-completions API key.
OPENROUTER_API_KEY=
# OpenRouter chat-completions endpoint.
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
# OpenRouter model id.
OPENROUTER_MODEL=
# Site name sent as attribution header to OpenRouter.
OPENROUTER_SITE_NAME=Edulari
# Groq API key for the student course-AI chat.
GROQ_API_KEY=
# Groq model id.
GROQ_MODEL=llama-3.3-70b-versatile
# Groq chat-completions endpoint.
GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
# NVIDIA NIM Kimi API key (inactive/standby provider).
NVIDIA_KIMI_API_KEY=
# NVIDIA NIM Kimi endpoint.
NVIDIA_KIMI_ENDPOINT=
# NVIDIA NIM Kimi model id.
NVIDIA_KIMI_MODEL=
# Max total seconds for a single AI call (PHP default 45, code shipped after testing at 10).
AI_REQUEST_TIMEOUT=45
# Seconds to wait while connecting to the AI provider.
AI_CONNECT_TIMEOUT=10
# Hard cap for the whole AI request including retries (PHP default 60).
AI_MAX_EXEC_TIME=60

# --- Cron ---
# Shared secret protecting /api/cron/* routes (Authorization: Bearer token).
CRON_SECRET=
