# scripts/ui-compare/.env.compare
#
# Local-only configuration for `npm run ui-compare`. Git-ignored: this file holds the
# throwaway login used to reach the authenticated pages on BOTH sites. Never commit it
# and never paste its values into a report.
#
# OLD_BASE / NEW_BASE
#   The two running copies. The old site is the PHP source served by PHP's built-in
#   server (see docs/UI_COMPARE.md section 2); the new site is `npm start`.
OLD_BASE=http://127.0.0.1:8080
NEW_BASE=http://127.0.0.1:3000

# Seeded on both sides by scripts/ui-compare/seed-compare.mjs.
# The new site already has a demo student from `npm run seed:content`:
#   COMPARE_EMAIL=student@edulari.test
#   COMPARE_PASSWORD=Edulari!Test2026
COMPARE_EMAIL=
COMPARE_PASSWORD=

# The /admin/** pages sit behind requireAdmin(); the student login above cannot reach
# them, and `--site new` would otherwise follow the login redirect and capture the wrong
# page. Create/delete a throwaway admin with:
#   node scripts/ui-compare/seed-compare-admin.mjs setup      (writes these two keys)
#   node scripts/ui-compare/seed-compare-admin.mjs teardown
# Admin pages are skipped cleanly when these are unset.
COMPARE_ADMIN_EMAIL=
COMPARE_ADMIN_PASSWORD=

# Path segments / ids the comparator substitutes into page URLs.
# Set these to a real instructor profile slug / paid order id / entity id on your dev data.
# A detail page whose id key is empty is SKIPPED, never mis-captured (see `requiresEnv`
# in config.mjs).
INSTRUCTOR_SLUG=
ORDER_ID=
ADMIN_USER_ID=
APPLICATION_ID=
EDIT_COURSE_ID=
BUG_ID=
CONTACT_ID=
